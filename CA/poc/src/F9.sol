pragma solidity ^0.8.13;

/// @title F9 (bytecode 0x8824fcf9...2a971c8a) — constants + interface
/// @notice Runtime bytecode of the F9 family (376 mainnet deployments), taken
///         verbatim from the Stage-2 chunk that produced the Kontrol proof.
library F9 {
    // 1142-byte runtime code. Dispatcher selectors:
    //   0x05b34410 -> slot1 getter
    //   0x0b5ab3d5 -> sweep: if (slot5 & 0xff == 0) call(slot2, selfbalance)
    //   0x13af4035 -> owner-only: set slot2 & slot3 (recipients)
    //   0x2b20e397 -> slot0 (owner) getter
    //   0x3fa4f245 -> slot4 getter
    //   0x674f220f -> slot3 getter
    //   0x8da5cb5b -> slot2 (recipient) getter
    //   0xbbe42771 -> owner-only: clear slot5 low byte + payout
    //   0xfaab9d39 -> owner-only: transferOwnership (slot0)
    //   0xfb1669ca -> owner-only: set slot4 + payout
    bytes internal constant BYTECODE = hex"";
}

// NOTE: no Solidity interface is declared for F9 on purpose. The dispatcher
// uses raw 4-byte selectors that do not correspond to canonical English
// signatures, so calls are issued as raw calldata (hex"0b5ab3d5") throughout
// the PoC. Selector -> slot mapping is documented in the F9 library comment.
