pragma solidity ^0.8.13;

import {Test} from "forge-std/Test.sol";

/// @notice Shared harness for every probe template. Fixes the two blind spots
/// of the original suite: (1) ERC-20 value movement (previously ETH only) and
/// (2) arbitrary storage injection (previously only `slot == attacker`).
///
/// Storage-injection is checked inline in each template over slots 0..15
/// (`P_STORAGE_CHANGED`); the attacker-address case keeps its own label
/// (`P_AUTH_WRITE`). Tokens are checked here via vm.load on MockERC20's fixed
/// slots (no mappings -> no symbolic-keccak blowup).
contract ProbeBase is Test {
    address internal constant USDC = 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48;
    address internal constant WETH = 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2;
    address internal constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
    address internal constant DAI = 0x6B175474E89094C44Da98b954EedeAC495271d0F;

    // MockERC20 runtime (src/MockERC20.sol); slots 0..3 = transferCount,
    // approveCount, lastTo, lastSpender.
    bytes internal constant MOCK_ERC20 = hex"";

    function _etchTokens() internal {
        vm.etch(USDC, MOCK_ERC20);
        vm.etch(WETH, MOCK_ERC20);
        vm.etch(USDT, MOCK_ERC20);
        vm.etch(DAI, MOCK_ERC20);
    }

    function _checkTokens(address attacker) internal {
        address[4] memory ts = [USDC, WETH, USDT, DAI];
        bytes32 atk = bytes32(uint256(uint160(attacker)));
        for (uint256 i = 0; i < 4; i++) {
            assertEq(uint256(vm.load(ts[i], bytes32(uint256(0)))), 0, "P_TOKEN_OUTFLOW");
            assertEq(uint256(vm.load(ts[i], bytes32(uint256(1)))), 0, "P_TOKEN_APPROVAL");
            assertTrue(vm.load(ts[i], bytes32(uint256(2))) != atk, "P_TOKEN_TO_ATTACKER");
        }
    }
}
